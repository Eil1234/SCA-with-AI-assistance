# Gemini AI API 配置
# 從 https://aistudio.google.com/app/apikeys 獲取免費 API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview

# AI 資源路徑（如使用非默認位置）
SCA_AI_DATA_PATH=./ai_assets/data
SCA_AI_MODEL_PATH=./ai_assets/models

# 最大 traces 數（0 表示無限制）
SCA_AI_MAX_TRACES=0

# 日誌級別
LOG_LEVEL=INFO

# 應用配置
HOST=0.0.0.0
PORT=8000
DEBUG=False

# 性能配置
MAX_WORKERS=4
CACHE_ENABLED=True
TIMEOUT=30
